config MBEDTLS_ZEPHYR_ENTROPY
    bool
source "Kconfig.zephyr"
config WIFI_SSID
    string "HaLow identity (unused by the camera protocol)"
    default "edgez-camera"
config WIFI_PSK
    string "HaLow PSK (unused by the camera protocol)"
    default ""
config CAMERA_UART_BAUD
    int "Camera UART baud rate"
    default 921600
config CAMERA_DTIM_SLEEP
    bool "Use the LED example's native AP/STA DTIM sleep contract"
    default y
config OFFGRID_NRF54_SENSOR_SPI_IRQ_SLEEP_NOPULL
    bool
    default y
config OFFGRID_NRF54_SENSOR_SPI_SLEEP_PINS
    bool
    default y

config CAMERA_DUMMY_IMAGE
    bool "Send deterministic JPEG test blocks instead of capturing a camera image"
    default n

config CAMERA_JPEG_RING_KB
    int "JPEG block ring payload capacity in KiB"
    range 2 32
    default 32
    help
      Bounded queue between the camera UART producer and radio block consumer.
      Use 16 or 32 KiB for larger captures. Metadata and the retry cache use
      additional RAM; UART DMA uses a separate byte ring.
